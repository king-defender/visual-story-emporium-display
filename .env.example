# Copy to .env. From your Supabase project's Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set on the Supabase project itself (dashboard or `supabase secrets set`), not here -
# the send-message edge function reads these server-side:
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=contact@yourdomain.com
#   CONTACT_EMAIL_TO=contact@artdirector.com
